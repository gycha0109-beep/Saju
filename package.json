{
  "name": "myeonghwa-saju-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Channel-neutral deterministic Saju calculation and interpretation engine for Myeonghwa.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./product-reading": {
      "types": "./dist/product-reading.d.ts",
      "default": "./dist/product-reading.js"
    },
    "./product-reading-response": {
      "types": "./dist/product-reading-response.d.ts",
      "default": "./dist/product-reading-response.js"
    },
    "./character-grounding": {
      "types": "./dist/character-grounding.d.ts",
      "default": "./dist/character-grounding.js"
    },
    "./product-host": {
      "types": "./dist/product-host.d.ts",
      "default": "./dist/product-host.js"
    },
    "./production-calculation-host": {
      "types": "./dist/production-calculation-host.d.ts",
      "default": "./dist/production-calculation-host.js"
    },
    "./production-runtime": {
      "types": "./dist/production-runtime.d.ts",
      "default": "./dist/production-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start:production-calculation": "node dist/production-calculation-server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src test package.json tsconfig.json tsconfig.build.json eslint.config.mjs .prettierrc.json .github/workflows/ci.yml",
    "format:check": "prettier --check src test package.json tsconfig.json tsconfig.build.json eslint.config.mjs .prettierrc.json .github/workflows/ci.yml",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run preview:research:smoke",
    "preview:research": "npm run build && node scripts/research-ux-preview.mjs",
    "preview:research:smoke": "MYEONGHWA_PREVIEW_SMOKE=1 node scripts/research-ux-preview.mjs",
    "face:verify:manifest": "node scripts/verify-face-reading-migration.mjs",
    "face:typecheck": "tsc -p tsconfig.face-reading.json --noEmit",
    "face:build": "tsc -p tsconfig.face-reading.build.json",
    "face:verify:fr76-parity": "npm run face:build && node scripts/verify-fr76-mediapipe-parity.mjs",
    "face:verify:fr77-runtime": "npm run face:build && node scripts/verify-fr77-governed-metric-runtime.mjs",
    "face:verify:fr78-lips-surface": "npm run face:build && node scripts/verify-fr78-governed-metric-lips-surface.mjs",
    "face:verify:fr79-pose-normalized-lips": "npm run face:build && node scripts/verify-fr79-pose-normalized-lips-geometry.mjs",
    "face:verify:fr80-neutral-mouth-metric": "npm run face:build && node scripts/verify-fr80-neutral-mouth-contour-metric.mjs",
    "face:verify:fr82-neutral-mouth-relative-size": "npm run face:build && node scripts/verify-fr82-neutral-mouth-relative-size-metric.mjs",
    "face:verify:fr85-role-free-contour-nesting": "npm run face:build && node scripts/verify-fr85-role-free-contour-nesting.mjs",
    "face:verify:fr88-role-free-minimum-set-separation": "npm run face:build && node scripts/verify-fr88-role-free-minimum-set-separation.mjs",
    "face:verify:fr98-role-free-arclength-mean-neutral-metric": "npm run face:build && node scripts/verify-fr98-role-free-arclength-mean-neutral-metric.mjs",
    "face:verify:fr158-role-invariant-eye-pair-neutral-shape": "node scripts/verify-fr158-role-invariant-eye-pair-neutral-shape.mjs",
    "face:verify:fr159-eye-pair-prospective-repeatability-protocol": "node scripts/verify-fr159-eye-pair-prospective-repeatability-protocol.mjs",
    "face:verify:fr160-eye-pair-prospective-acquisition-runtime": "node scripts/verify-fr160-eye-pair-prospective-acquisition-runtime.mjs",
    "face:verify:fr178-eye-pair-geometric-y-span": "node scripts/verify-fr178-eye-pair-geometric-y-span.mjs",
    "check:face-reading": "npm run face:verify:manifest && npm run face:typecheck && npm run face:build && npm run face:verify:fr158-role-invariant-eye-pair-neutral-shape && npm run face:verify:fr159-eye-pair-prospective-repeatability-protocol && npm run face:verify:fr160-eye-pair-prospective-acquisition-runtime && npm run face:verify:fr178-eye-pair-geometric-y-span && npm run face:verify:fr318-fr319-local-executor && npm run face:verify:fr313-fr319-local-executor && npm run face:verify:fr308-fr312-local-executor && npm run face:verify:fr307-review-packet && npm run face:verify:hairline-multisignal-candidate && npm run face:verify:hairline-multisignal-review-packet",
    "face:dry-run:operator": "npm run face:build && node scripts/mesh6j-manual-browser-capture-preview.mjs",
    "face:dry-run:phone": "npm run face:build && node -e \"process.env.MESH6J_LAN='1'; import('./scripts/mesh6j-manual-browser-capture-preview.mjs')\"",
    "face:run:fr318-fr319-local": "npm run face:build && node scripts/run-fr318-fr319-local-evidence.mjs",
    "face:verify:fr318-fr319-local-executor": "node scripts/run-fr318-fr319-local-evidence.mjs --self-check",
    "face:run:fr313-fr319-local": "npm run face:build && node scripts/run-fr313-fr319-local-evidence.mjs",
    "face:verify:fr313-fr319-local-executor": "node scripts/run-fr313-fr319-local-evidence.mjs --self-check",
    "face:run:fr308-fr312-local": "npm run face:build && node scripts/run-fr308-fr312-local-validation.mjs",
    "face:verify:fr308-fr312-local-executor": "node scripts/run-fr308-fr312-local-validation.mjs --self-check",
    "face:review:fr307": "node scripts/run-fr307-hairline-review-packet.mjs",
    "face:verify:fr307-review-packet": "node scripts/run-fr307-hairline-review-packet.mjs --self-check",
    "face:run:hairline-multisignal-candidate": "python3 tools/face-reading/hairline/run_multisignal_visible_hairline_candidate.py",
    "face:run:hairline-fresh-validation": "npm run face:build && node scripts/run-fresh-hairline-validation.mjs",
    "face:verify:hairline-multisignal-candidate": "python3 tools/face-reading/hairline/run_multisignal_visible_hairline_candidate.py --self-check",
    "face:review:hairline-multisignal": "npm run face:build && node scripts/run-multisignal-hairline-review-packet.mjs",
    "face:verify:hairline-multisignal-review-packet": "npm run face:build && node scripts/run-multisignal-hairline-review-packet.mjs --self-check",
    "start:source-proof-staging": "node dist/source-reading-proof-server.js"
  },
  "dependencies": {
    "manseryeok": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "workspaces": [
    "packages/face-reading"
  ]
}
