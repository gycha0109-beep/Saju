{
  "name": "myeonghwa-saju-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Channel-neutral deterministic Saju calculation and interpretation engine for Myeonghwa.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./product-reading": {
      "types": "./dist/product-reading.d.ts",
      "default": "./dist/product-reading.js"
    },
    "./product-host": {
      "types": "./dist/product-host.d.ts",
      "default": "./dist/product-host.js"
    },
    "./production-calculation-host": {
      "types": "./dist/production-calculation-host.d.ts",
      "default": "./dist/production-calculation-host.js"
    },
    "./production-runtime": {
      "types": "./dist/production-runtime.d.ts",
      "default": "./dist/production-runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src test package.json tsconfig.json tsconfig.build.json eslint.config.mjs .prettierrc.json .github/workflows/ci.yml",
    "format:check": "prettier --check src test package.json tsconfig.json tsconfig.build.json eslint.config.mjs .prettierrc.json .github/workflows/ci.yml",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run preview:research:smoke",
    "preview:research": "npm run build && node scripts/research-ux-preview.mjs",
    "preview:research:smoke": "MYEONGHWA_PREVIEW_SMOKE=1 node scripts/research-ux-preview.mjs",
    "face:verify:manifest": "node scripts/verify-face-reading-migration.mjs",
    "face:typecheck": "tsc -p tsconfig.face-reading.json --noEmit",
    "face:build": "tsc -p tsconfig.face-reading.build.json",
    "face:verify:fr76-parity": "npm run face:build && node scripts/verify-fr76-mediapipe-parity.mjs",
    "face:verify:fr77-runtime": "npm run face:build && node scripts/verify-fr77-governed-metric-runtime.mjs",
    "face:verify:fr78-lips-surface": "npm run face:build && node scripts/verify-fr78-governed-metric-lips-surface.mjs",
    "face:verify:fr79-pose-normalized-lips": "npm run face:build && node scripts/verify-fr79-pose-normalized-lips-geometry.mjs",
    "face:verify:fr80-neutral-mouth-metric": "npm run face:build && node scripts/verify-fr80-neutral-mouth-contour-metric.mjs",
    "face:verify:fr82-neutral-mouth-relative-size": "npm run face:build && node scripts/verify-fr82-neutral-mouth-relative-size-metric.mjs",
    "face:verify:fr85-role-free-contour-nesting": "npm run face:build && node scripts/verify-fr85-role-free-contour-nesting.mjs",
    "face:verify:fr88-role-free-minimum-set-separation": "npm run face:build && node scripts/verify-fr88-role-free-minimum-set-separation.mjs",
    "face:verify:fr98-role-free-arclength-mean-neutral-metric": "npm run face:build && node scripts/verify-fr98-role-free-arclength-mean-neutral-metric.mjs",
    "check:face-reading": "npm run face:verify:manifest && npm run face:typecheck && npm run face:build"
  },
  "dependencies": {
    "manseryeok": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "workspaces": [
    "packages/face-reading"
  ]
}
